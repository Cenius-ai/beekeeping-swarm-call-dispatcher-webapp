# Beekeeping Swarm Call Dispatcher — environment template.
#
# Copy this to `.env` if you want to override anything (install.sh does it for
# you). Every variable here has a working development default in the code, so a
# clean checkout with NO .env file boots straight into a seeded, signed-in app.

# Session signing key. `install.sh` writes a generated value here on first run;
# without a .env file the app falls back to a clearly-marked development key.
SECRET_KEY=

# Embedded SQLite database, relative to the project root. Created, migrated and
# seeded automatically on every boot path (python3 app.py, a WSGI server, tests).
DATABASE_URL=sqlite:///./data.db
